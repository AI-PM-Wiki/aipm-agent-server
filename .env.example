PORT=8787
# 绑定地址:默认仅回环 127.0.0.1;公网暴露需显式 HOST=0.0.0.0 并自备防护
HOST=127.0.0.1
ANTHROPIC_API_KEY=
# 隧道由 VPS 系统级 cloudflared 负责(/etc/cloudflared/config.yml),无容器 token
MODEL=claude-opus-5
EFFORT=medium
MAX_BUDGET_USD=0.30
MAX_TURNS=8
SITE_BASE=https://aipm.ac
SEARCH_INDEX_URL=https://aipm.ac/search/search_index.json
INDEX_REFRESH_MS=1800000
ALLOWED_ORIGINS=https://aipm.ac,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=600000
CONCURRENCY_LIMIT=4
QUEUE_LIMIT=10
QUEUE_WAIT_MS=60000
# 无 Origin 请求(curl/脚本)须携带 X-API-Key;留空 = 不校验
API_KEY=
# 每日预算护栏(USD,0=关闭;1.4 ≈ ￥10/天)
DAILY_BUDGET_USD=1.4
BODY_LIMIT_BYTES=65536
# 请求体读取超时(ms):慢速 POST 防 DoS
BODY_TIMEOUT_MS=15000
# 单轮问答墙钟上限(ms):到点强制中止,防 agent 挂死
MAX_RUN_MS=120000
# VPS + Cloudflare 隧道部署必须为 true(限流取 cf-connecting-ip 真实 IP)
TRUST_PROXY=true
SCRATCH_DIR=/tmp/aipm-agent-scratch
